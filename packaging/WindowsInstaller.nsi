; Optional Windows installer generated by makensis on macOS or Linux.
; Required: -DINPUT_EXE=... -DOUTFILE=... -DLICENSE_PATH=...
Unicode True
Name "ChessPrune"
OutFile "${OUTFILE}"
InstallDir "$LOCALAPPDATA\ChessPrune"
RequestExecutionLevel user
ShowInstDetails show
ShowUninstDetails show
Page directory
Page instfiles
UninstPage uninstConfirm
UninstPage instfiles

Section "ChessPrune"
  SetOutPath "$INSTDIR"
  File /oname=ChessPrune.exe "${INPUT_EXE}"
  File /oname=LICENSE "${LICENSE_PATH}"
  CreateDirectory "$SMPROGRAMS\ChessPrune"
  CreateShortCut "$SMPROGRAMS\ChessPrune\ChessPrune.lnk" "$INSTDIR\ChessPrune.exe"
  CreateShortCut "$SMPROGRAMS\ChessPrune\Uninstall.lnk" "$INSTDIR\Uninstall.exe"
  WriteUninstaller "$INSTDIR\Uninstall.exe"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\ChessPrune" "DisplayName" "ChessPrune"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\ChessPrune" "UninstallString" '"$INSTDIR\Uninstall.exe"'
  WriteRegDWORD HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\ChessPrune" "NoModify" 1
  WriteRegDWORD HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\ChessPrune" "NoRepair" 1
SectionEnd

Section "Uninstall"
  Delete "$SMPROGRAMS\ChessPrune\ChessPrune.lnk"
  Delete "$SMPROGRAMS\ChessPrune\Uninstall.lnk"
  RMDir "$SMPROGRAMS\ChessPrune"
  Delete "$INSTDIR\ChessPrune.exe"
  Delete "$INSTDIR\LICENSE"
  Delete "$INSTDIR\Uninstall.exe"
  RMDir "$INSTDIR"
  DeleteRegKey HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\ChessPrune"
SectionEnd
